<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_tv_button_secondary"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="← Geri"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="PC ve TV Kaynak Seçimi"
            android:textColor="@color/tv_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveSettings"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_tv_button_primary"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Kaydet"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- PROFILE SELECTOR BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSettingsProfiles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:nestedScrollingEnabled="false" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNewProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tv_button_secondary"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="+ Yeni"
                    android:textAllCaps="false"
                    android:textColor="@color/tv_focus_ring"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeleteProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tv_button_secondary"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Sil"
                    android:textAllCaps="false"
                    android:textColor="@color/tv_error"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- SECTION 1: PC / Wake-on-LAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tv_card_selector"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. BİLGİSAYAR (WAKE-ON-LAN)"
                            android:textColor="@color/tv_focus_ring"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNetworkScanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ağı tarayarak cihaz seçebilir veya elle girebilirsiniz."
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnScanNetwork"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tv_button_secondary"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Ağı Tara"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDiscoveredPcs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <!-- Manual PC Fields Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PC Adı"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etPcName"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_tv_input"
                            android:hint="Ana PC"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="@color/tv_text_primary"
                            android:textColorHint="@color/tv_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IP Adresi"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etPcIp"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_tv_input"
                            android:hint="10.0.0.132"
                            android:imeOptions="actionNext"
                            android:inputType="textUri"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="@color/tv_text_primary"
                            android:textColorHint="@color/tv_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Manual PC Fields Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MAC Adresi"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etPcMac"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_tv_input"
                            android:hint="E0:51:D8:1C:50:DB"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="@color/tv_text_primary"
                            android:textColorHint="@color/tv_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WoL Port"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etWolPort"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_tv_input"
                            android:hint="9"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="@color/tv_text_primary"
                            android:textColorHint="@color/tv_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Sleep / Shutdown URL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Uzak Uyku / Kapatma URL'si (Opsiyonel)"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etSleepUrl"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_tv_input"
                    android:hint="Örn: http://10.0.0.132:5050/sleep"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- SECTION 2: TV SOURCE / INPUT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tv_card_selector"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. TV KAYNAK (SOURCE / HDMI)"
                            android:textColor="@color/tv_focus_ring"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSourceScanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="TV girişlerini tarayıp seçebilir veya elle girebilirsiniz."
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnScanSources"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tv_button_secondary"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Kaynakları Tara"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTvSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <!-- Manual TV Source Fields -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kaynak Adı (Örn: HDMI 4)"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etSourceLabel"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_tv_input"
                            android:hint="HDMI 4"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="@color/tv_text_primary"
                            android:textColorHint="@color/tv_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kaynak Input ID (Opsiyonel)"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etSourceInputId"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_tv_input"
                            android:hint="Otomatik (ada göre)"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="@color/tv_text_primary"
                            android:textColorHint="@color/tv_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 3: BEHAVIOR & RESET -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tv_card_selector"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWaitForPcOnline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:text="PC açılınca kaynağa geç (PC çevrimiçi olana kadar bekle)"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWolRetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:focusable="true"
                    android:text="Bekleme sırasında her 5 sn'de bir ek WoL paketi gönder"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoRun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:focusable="true"
                    android:text="Açılışta otomatik uyandır ve kaynağa geç (3 sn geri sayım)"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bekleme sınırı (sn):"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etWaitTimeout"
                        android:layout_width="56dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_tv_input"
                        android:gravity="center"
                        android:inputType="number"
                        android:singleLine="true"
                        android:text="45"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geçiş gecikmesi (sn):"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etSwitchDelay"
                        android:layout_width="56dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tv_input"
                        android:gravity="center"
                        android:inputType="number"
                        android:singleLine="true"
                        android:text="1"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnResetDefaults"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tv_button_secondary"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Varsayılana Sıfırla"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_warning"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
